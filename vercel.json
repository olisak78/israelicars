{
  "build": {
    "env": {
      "NPM_CONFIG_LEGACY_PEER_DEPS": "true"
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "israelicars.com"
        }
      ],
      "destination": "https://www.israelicars.com/:path*",
      "permanent": true
    }
  ]
}
